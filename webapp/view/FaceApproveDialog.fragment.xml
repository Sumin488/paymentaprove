<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="faceApproveDialog"
        title="안면 인증"
        contentWidth="26rem"
        contentHeight="18rem"
        draggable="false"
        resizable="false"
        stretchOnPhone="true"
        afterOpen=".onFaceApproveDialogAfterOpen"
        afterClose=".onFaceApproveDialogAfterClose">

        <VBox
            width="100%"
            alignItems="Center"
            justifyContent="Center"
            class="sapUiMediumMargin">

            <core:Icon
                src="sap-icon://person-placeholder"
                size="5rem"
                color="#0A6ED1"
                class="sapUiSmallMarginBottom" />

            <Title
                text="안면 인증 중"
                level="H3"
                class="sapUiTinyMarginBottom" />

            <Text
                text="{faceAuth>/StatusText}"
                textAlign="Center"
                class="sapUiSmallMarginBottom" />

            <BusyIndicator
                size="2rem"
                visible="{faceAuth>/Busy}" />

            <ObjectStatus
                text="{faceAuth>/DistanceText}"
                state="{faceAuth>/DistanceState}"
                class="sapUiSmallMarginTop" />

            <!--
                실제 얼굴 분석용 video.
                화면에는 보이지 않지만 face-api.js가 내부적으로 사용한다.
                display:none은 브라우저에 따라 video frame 처리 문제가 생길 수 있으므로
                1px + opacity 0 방식으로 숨긴다.
            -->
            <core:HTML
                id="faceApproveHiddenVideoHtml"
                content="&lt;video id='approveFaceVideo' width='640' height='480' autoplay muted playsinline style='position:absolute;width:1px;height:1px;opacity:0;left:-9999px;top:-9999px;'&gt;&lt;/video&gt;" />

        </VBox>

        <endButton>
            <Button
                text="취소"
                enabled="{= !${faceAuth>/Saving} }"
                press=".onCancelFaceApprove" />
        </endButton>

    </Dialog>
</core:FragmentDefinition>